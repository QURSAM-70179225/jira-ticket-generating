# Copy this file to .env and put your own key in it. Never commit .env.
# Get a free key at https://console.groq.com -> API Keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: use a different Groq model (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-20b

# Optional: tokens-per-minute limit of your Groq plan (default: 8000, the free tier)
# GROQ_TPM_LIMIT=8000
